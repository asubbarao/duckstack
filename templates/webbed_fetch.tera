{# Render a complete read-only Webbed page-inspection query.
   sources = [{source, kind, url, curl_flags, crawler_options}].
   crawler_options are ordered trusted SQL {name, value} fragments. #}
WITH raw_sources AS (
{%- for source in sources %}
{%- if source.kind == "crawler" %}
    -- crawl row: {url, status, html.document, error}; normalize document to HTML.
    SELECT '{{ source.source }}' AS source, url, status::VARCHAR AS status,
           html.document::HTML AS document, error
    FROM crawl(
        ['{{ source.url }}'],
        {%- for option in source.crawler_options %}
        {% if option.name == "extract" %}"extract"{% else %}{{ option.name }}{% endif %} := {{ option.value }}{% if not loop.last %},{% endif %}
        {%- endfor %}
    )
{%- elif source.kind == "http_client" %}
    -- http_get response STRUCT: {status, body JSON, headers, ...}; unwrap body JSON to HTML.
    SELECT '{{ source.source }}' AS source, '{{ source.url }}' AS url,
           response.status::VARCHAR AS status,
           json_extract_string(response.body, '$')::HTML AS document,
           NULL::VARCHAR AS error
    FROM (SELECT http_get('{{ source.url }}') AS response)
{%- elif source.kind == "shellfs_curl" %}
    -- read_csv over ShellFS curl stdout: {body_base64 VARCHAR}; decode it to HTML.
    SELECT '{{ source.source }}' AS source, '{{ source.url }}' AS url,
           NULL::VARCHAR AS status, decode(from_base64(body_base64))::HTML AS document,
           NULL::VARCHAR AS error
    FROM read_csv(
        $cmd$curl {{ source.curl_flags }} '{{ source.url }}' | base64 | tr -d '\n' |$cmd$,
        header := false,
        columns := {'body_base64': 'VARCHAR'}
    )
{%- endif %}
{%- if not loop.last %}
    UNION ALL
{%- endif %}
{%- endfor %}
),
documents AS (
    -- Shared normalized shape: {source, url, status, document HTML, error}.
    SELECT *, len(document)::BIGINT AS raw_chars,
           left(document::VARCHAR, 50) AS preview,
           len(html_to_duck_blocks(document))::BIGINT AS block_count,
           html_extract_links(document) AS extracted_links
    FROM raw_sources
),
responses AS (
    SELECT source, 'response' AS row_kind, url, status, raw_chars, preview, block_count,
           NULL::VARCHAR AS link_text, NULL::VARCHAR AS href, error
    FROM documents
),
links AS (
    -- extracted_links is LIST<STRUCT(text, href, title, line_number)>.
    SELECT document.source, 'link' AS row_kind, document.url, document.status,
           NULL::BIGINT AS raw_chars, NULL::VARCHAR AS preview, NULL::BIGINT AS block_count,
           left(link.text, 50) AS link_text, link.href, document.error,
           row_number() OVER (PARTITION BY document.source ORDER BY link.href) AS source_link_number
    FROM documents AS document
    CROSS JOIN UNNEST(document.extracted_links) AS links(link)
)
SELECT * FROM responses
UNION ALL
SELECT source, row_kind, url, status, raw_chars, preview, block_count, link_text, href, error
FROM links
WHERE source_link_number <= 8
ORDER BY source, row_kind, href;
