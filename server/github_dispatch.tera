{#- One stage: render github_fetch.tera for every gh_todo row of this kind and phase, post each to
    /sql, and keep statement and receipt. first = the one row that creates the kind's table. -#}
INSERT INTO agents.gh_dispatch BY NAME
WITH rendered AS (
  SELECT kind, ctx,
    tera_render(content, json_merge_patch(ctx, json_object('kind', kind, 'create', is_first)), autoescape := false) AS statement
  FROM agents.gh_todo CROSS JOIN read_text('{{ fetch_template }}')
  WHERE kind = '{{ kind }}' AND is_first = {{ first }}),
sent AS (
  SELECT array_agg({kind: kind, ctx: ctx, statement: statement,
    receipt: http_post_form('{{ sql_url }}', MAP{}, MAP{'sql': statement})}) AS receipts
  FROM rendered)
SELECT now() AS sent_at, r.kind, r.ctx, r.statement, r.receipt.status AS status, r.receipt.body AS body
FROM sent CROSS JOIN UNNEST(receipts) AS u(r)
