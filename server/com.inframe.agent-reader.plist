<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.inframe.agent-reader</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-c</string>
    <string>export QUACK_TOKEN="$(cat /Users/aloksubbarao/.duck/token)"; exec /opt/homebrew/bin/duckdb -unsigned :memory: -cmd '.read /Users/aloksubbarao/duckdb-skills/server/agent_reader.sql' &lt; &lt;(tail -f /dev/null)</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>WorkingDirectory</key><string>/Users/aloksubbarao/.duck</string>
  <key>StandardOutPath</key><string>/Users/aloksubbarao/.duck/logs/agent-reader.out</string>
  <key>StandardErrorPath</key><string>/Users/aloksubbarao/.duck/logs/agent-reader.err</string>
</dict>
</plist>
