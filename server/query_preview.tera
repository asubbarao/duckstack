-- One lookahead row proves truncation. Reserve 256 bytes of the 8 KiB budget for metadata.
-- query() preserves the caller's SQL, including trailing comments/semicolons, ordering and inner LIMIT.
WITH bounded AS (
    SELECT * FROM query({{ sql }}) LIMIT 51
), numbered AS (
    SELECT row_number() OVER () AS idx, to_json(bounded) AS row
    FROM bounded
), sized AS (
    SELECT *, 1 + sum(strlen(row::VARCHAR) + 1) OVER (ORDER BY idx ROWS UNBOUNDED PRECEDING) AS used_bytes
    FROM numbered
), summary AS (
    SELECT array_agg(row ORDER BY idx) AS observed_rows, count(idx) AS observed,
           coalesce(max(CASE WHEN idx <= 50 AND used_bytes <= 7936 THEN idx ELSE 0 END), 0) AS returned_rows
    FROM sized
), result AS (
SELECT coalesce(observed_rows[1:returned_rows], []::JSON[]) AS rows, returned_rows,
       observed > returned_rows AS truncated,
       CASE WHEN NOT truncated THEN NULL
            WHEN returned_rows = 0 THEN 'oversized_row'
            WHEN returned_rows < least(observed, 50) THEN 'byte_limit'
            ELSE 'row_limit' END AS reason,
       50 AS row_limit, 8192 AS byte_limit
FROM summary
)
SELECT to_json(result) AS preview FROM result
