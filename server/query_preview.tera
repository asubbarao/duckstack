-- One lookahead row proves truncation. The render context reserves room for metadata.
-- query() preserves the caller's SQL, including trailing comments/semicolons, ordering and inner LIMIT.
WITH bounded AS (
    SELECT * FROM query({{ sql }}) LIMIT {{ row_limit }} + 1
), sized AS (
    SELECT row_number() OVER w AS idx, to_json(bounded) AS row,
           1 + sum(strlen(row::VARCHAR) + 1) OVER w AS used_bytes
    FROM bounded
    WINDOW w AS (ROWS UNBOUNDED PRECEDING)
), summary AS (
    SELECT array_agg(row ORDER BY idx) AS observed_rows, count(idx) AS observed,
           count(CASE WHEN idx <= {{ row_limit }} AND used_bytes <= {{ byte_limit }} - {{ reserved_bytes }} THEN idx END) AS returned_rows
    FROM sized
), result AS (
    SELECT coalesce(observed_rows[1:returned_rows], []::JSON[]) AS rows, returned_rows,
           observed > returned_rows AS truncated,
           CASE WHEN NOT truncated THEN NULL
                WHEN returned_rows = 0 THEN 'oversized_row'
                WHEN returned_rows < {{ row_limit }} THEN 'byte_limit'
                ELSE 'row_limit' END AS reason,
           {{ row_limit }} AS row_limit, {{ byte_limit }} AS byte_limit
    FROM summary
)
SELECT to_json(result) AS preview FROM result
