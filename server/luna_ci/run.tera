-- One complete SQL body per input row.  The handler supplies SQL-quoted
-- literals, so the brief is written by DuckDB rather than embedded in a shell
-- heredoc.  The final read_text call forks a detached Codex process and
-- returns its pid to the caller.
SELECT content FROM read_text({{ mkdir_sql }} || ' |');
COPY (SELECT {{ brief_literal }}) TO {{ brief_path_literal }}
    (FORMAT csv, HEADER false, QUOTE '');
SELECT content FROM read_text({{ launch_sql }} || ' |');
