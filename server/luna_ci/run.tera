D='{{ run_dir }}'; W='{{ worktree }}'; B='{{ bare }}'; U='{{ push_url }}'
echo $$ > "$D/pid"
exec > "$D/prep.log" 2>&1
echo "prep start $(date -u +%FT%TZ)"
[ -d "$B" ] || git clone --bare "$U" "$B"
git -C "$B" fetch "$U" '{{ head_branch }}'
# Detached: an earlier run's worktree may still hold the branch name; the brief pushes HEAD:<branch>.
git -C "$B" worktree add -f --detach "$W" {{ head_sha }}
git -C "$W" submodule update --init --depth 1 --recursive
{% for j in jobs %}{% if j.job_id %}GH_TOKEN=$(gh auth token --user asubbarao) gh run view --job {{ j.job_id }} --log-failed -R {{ repo }} > "$D/logs/{{ j.job_id }}.log"
{% endif %}{% endfor -%}
echo "prep end $(date -u +%FT%TZ)"
if [ "$(git -C "$W" rev-parse HEAD)" = {{ head_sha }} ]; then
  /Users/aloksubbarao/.local/bin/codex exec -C "$W" --add-dir "$B" -s workspace-write -c sandbox_workspace_write.network_access=true -m gpt-5.6-luna -c model_reasoning_effort="high" --color never --json -o "$D/out.md" - < "$D/brief.md" > "$D/events.jsonl" 2> "$D/run.log"
  echo $? > "$D/exit"
else
  { echo "Worktree preparation failed; Luna was not started. Tail of prep.log:"; tail -n 40 "$D/prep.log"; } > "$D/out.md"
  echo 98 > "$D/exit"
fi
