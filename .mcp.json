{
  "mcpServers": {
    "fledgling": {
      "type": "stdio",
      "command": "fledgling-mcp",
      "args": ["serve", "--profile", "analyst", "--transport", "stdio", "--root", "."],
      "env": {}
    },
    "squackit": {
      "type": "stdio",
      "command": "squackit",
      "args": ["mcp", "serve"],
      "env": {}
    },
    "dev": {
      "type": "http",
      "url": "http://localhost:9496/mcp"
    }
  }
}
