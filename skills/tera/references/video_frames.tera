{#- video_frames.tera: a slice of a video as rows of frames, streamed through read_csv, each frame hashed by pic2vec.
    The JPEGs land in out_dir; the rows come back in the receipt. The frame writer is macOS AVFoundation (`swift -`),
    nothing to install.
    Row (every value declared by the caller; nothing defaults here):
      video      absolute path of the video file
      out_dir    absolute directory for the JPEG frames (created if missing)
      fps        frames per second to sample: 2 for a demo, 0.5 for slides, 10 to 30 for fast motion
      start, end seconds of the slice; end -1 means to the end of the video
      width      frame width in pixels; height keeps the aspect ratio
      quality    JPEG quality 0..1
      sql_tag    dollar-quote tag absent from the script, e.g. 'frames_cmd'
    Columns: second DOUBLE (from the start of the video), path VARCHAR, phash VARCHAR.
    shellfs and pic2vec are loaded on the server. Frames stream: one row per frame as it is written. -#}
SELECT second, path, pic_phash(path) AS phash
FROM read_csv(${{ sql_tag }}$mkdir -p '{{ out_dir }}' && swift - '{{ video }}' '{{ out_dir }}' {{ fps }} {{ width }} {{ start }} {{ end }} {{ quality }} 2>/dev/null <<'VIDEO_FRAMES_SWIFT'
import AVFoundation
import AppKit
setvbuf(stdout, nil, _IOLBF, 0)
let a = CommandLine.arguments
let asset = AVURLAsset(url: URL(fileURLWithPath: a[1]))
let generator = AVAssetImageGenerator(asset: asset)
generator.appliesPreferredTrackTransform = true
generator.requestedTimeToleranceBefore = .zero
generator.requestedTimeToleranceAfter = .zero
generator.maximumSize = CGSize(width: Double(a[4])!, height: Double(a[4])!)
let step = 1.0 / Double(a[3])!
let duration = CMTimeGetSeconds(asset.duration)
let end = Double(a[6])! < 0 ? duration : min(Double(a[6])!, duration)
let quality = Double(a[7])!
print("second,path")
var t = Double(a[5])!
while t < end {
  if let image = try? generator.copyCGImage(at: CMTime(seconds: t, preferredTimescale: 600), actualTime: nil) {
    let path = String(format: "%@/frame_%010.3f.jpg", a[2], t)
    try? NSBitmapImageRep(cgImage: image).representation(using: .jpeg, properties: [.compressionFactor: quality])?.write(to: URL(fileURLWithPath: path))
    print("\(t),\(path)")
  }
  t += step
}
VIDEO_FRAMES_SWIFT
|${{ sql_tag }}$, header := true)
