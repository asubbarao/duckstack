{#- video_frames.tera: a slice of a video becomes rows of frames, streamed through read_csv, each frame hashed by pic2vec.
    Every knob is a context value; SQL prepares the context, so a busy interval can be re-rendered at a higher rate.
    Context (trusted authored fragments, not escaped):
      video          absolute path of the video file
      out_dir        absolute directory for the JPEG frames (created if missing)
      fps            frames per second to sample: 2 for a demo, 0.5 for slides, 10 to 30 to catch fast motion
      start, end     seconds; the slice to sample (default: the whole video)
      width          frame width in pixels, height keeps the aspect ratio
      quality        JPEG quality 0..1 (avfoundation) or ffmpeg -q:v 1..31 (ffmpeg); default 0.8 / 3
      engine         'avfoundation' (macOS built-in) or 'ffmpeg' (ffmpeg on PATH)
      ffmpeg_input_flags   list of flags before -i, e.g. ["-hwaccel", "videotoolbox"]
      ffmpeg_filters       list of -vf filter steps appended after fps/scale, e.g. ["eq=contrast=1.2", "crop=iw/2:ih:0:0"]
      ffmpeg_output_flags  list of flags before the output path, e.g. ["-frames:v", "500"]
      sql_tag        dollar-quote tag absent from the script, e.g. 'frames_cmd'
    Output columns: second DOUBLE (absolute, from the start of the video), path VARCHAR, phash VARCHAR.
    avfoundation streams one row per frame as it is written; ffmpeg writes the slice first, then lists it. -#}
{%- set start = start | default(value=0) -%}
{%- set fps = fps | default(value=2) -%}
{%- set width = width | default(value=1400) -%}
INSTALL shellfs FROM community; LOAD shellfs;
INSTALL pic2vec FROM community; LOAD pic2vec;
SELECT second, path, pic_phash(path) AS phash
FROM read_csv(${{ sql_tag }}$mkdir -p '{{ out_dir }}' && {% if engine == "ffmpeg" -%}
ffmpeg -nostdin -loglevel error{% for flag in ffmpeg_input_flags | default(value=[]) %} {{ flag }}{% endfor %} -ss {{ start }}{% if end %} -to {{ end }}{% endif %} -i '{{ video }}' -vf 'fps={{ fps }},scale={{ width }}:-2{% for step in ffmpeg_filters | default(value=[]) %},{{ step }}{% endfor %}' -q:v {{ quality | default(value=3) }}{% for flag in ffmpeg_output_flags | default(value=[]) %} {{ flag }}{% endfor %} '{{ out_dir }}/slice_{{ start }}_%06d.jpg' && echo second,path && ls '{{ out_dir }}' | grep '^slice_{{ start }}_' | sort | awk -v d='{{ out_dir }}' -v s={{ start }} -v f={{ fps }} '{ n = substr($0, length($0) - 9, 6) + 0; printf "%.3f,%s/%s\n", s + (n - 1) / f, d, $0 }'
{%- else -%}
swift - '{{ video }}' '{{ out_dir }}' {{ fps }} {{ width }} {{ start }} {{ end | default(value=-1) }} {{ quality | default(value=0.8) }} 2>/dev/null <<'VIDEO_FRAMES_SWIFT'
import AVFoundation
import AppKit
setvbuf(stdout, nil, _IOLBF, 0)
let a = CommandLine.arguments
let asset = AVURLAsset(url: URL(fileURLWithPath: a[1]))
let generator = AVAssetImageGenerator(asset: asset)
generator.appliesPreferredTrackTransform = true
generator.requestedTimeToleranceBefore = .zero
generator.requestedTimeToleranceAfter = .zero
generator.maximumSize = CGSize(width: Double(a[4])!, height: Double(a[4])!)
let step = 1.0 / Double(a[3])!
let duration = CMTimeGetSeconds(asset.duration)
let end = Double(a[6])! < 0 ? duration : min(Double(a[6])!, duration)
let quality = Double(a[7])!
print("second,path")
var t = Double(a[5])!
while t < end {
  if let image = try? generator.copyCGImage(at: CMTime(seconds: t, preferredTimescale: 600), actualTime: nil) {
    let path = String(format: "%@/frame_%010.3f.jpg", a[2], t)
    try? NSBitmapImageRep(cgImage: image).representation(using: .jpeg, properties: [.compressionFactor: quality])?.write(to: URL(fileURLWithPath: path))
    print("\(t),\(path)")
  }
  t += step
}
VIDEO_FRAMES_SWIFT
{%- endif %}
|${{ sql_tag }}$, delim = ',', header = true, columns = {'second': 'DOUBLE', 'path': 'VARCHAR'});
