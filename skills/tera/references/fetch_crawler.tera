{#- One page through the crawler extension. Context: url, user_agent, timeout, params = [{name, value}].
    Parameters: the context becomes crawl's := options. Loop: params render the query string.
    crawl(url, ...) is the single-URL overload; the rendered url is a literal, so it binds. crawl_url is not used:
    in a lateral its := names are dropped and no overload matches (422). max_results := 1 bounds the fetch to one row.
    crawl takes no headers. The html struct's document is the body. Render, html_unescape, self-dispatch. -#}
SELECT 'crawler' AS method, status, html.document AS body, error
FROM crawl('{{ url }}{% for p in params %}{% if loop.first %}?{% else %}&{% endif %}{{ p.name }}={{ p.value }}{% endfor %}',
    cache := false, cache_ttl := 24, timeout := {{ timeout }}, delay := 0, workers := 1, batch_size := 1,
    respect_robots := true, follow := '', max_depth := 1, state_table := '',
    user_agent := '{{ user_agent }}', max_results := 1, "extract" := []::VARCHAR[])
