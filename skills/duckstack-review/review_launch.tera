{# The review's launch, run on dev in the background. Row: checkout (the tick's own checkout, so rubric and schema
   match its queue.sql), review_key (<pr>-<sha>). Output lands in results/<review_key>.json once claude exits. #}
(cd /Users/aloksubbarao/.duck/review && cat {{ checkout }}/skills/duckstack-review/SKILL.md {{ checkout }}/skills/self-dispatch/RULES.md {{ checkout }}/SQL-MANIFESTO.md prompts/review_key={{ review_key }}/data_0.csv | /Users/aloksubbarao/.local/bin/claude -p --model claude-opus-5-5 --tools "" --output-format json --no-session-persistence --strict-mcp-config --disable-slash-commands --settings '{"disableAllHooks": true}' --json-schema "$(cat {{ checkout }}/skills/duckstack-review/review_schema.json)" > results/{{ review_key }}.part 2>&1; mv results/{{ review_key }}.part results/{{ review_key }}.json) > /dev/null 2>&1 & echo $! |
