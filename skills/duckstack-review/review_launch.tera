{# The review's launch, run on dev in the background. The row declares everything: rubric (files fed to claude
   ahead of the prompt), claude (the command and its flags), schema (the JSON schema file), review_key. #}
(cd /Users/aloksubbarao/.duck/review && cat {{ rubric | join(sep=" ") }} prompts/review_key={{ review_key }}/data_0.csv | {{ claude | join(sep=" ") }} --json-schema "$(cat {{ schema }})" > results/{{ review_key }}.part 2>&1; mv results/{{ review_key }}.part results/{{ review_key }}.json) > /dev/null 2>&1 & echo $! |
